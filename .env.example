# --- Access control (single shared login — this is a small internal tool, not a public app) ---
APP_USERNAME=admin
APP_PASSWORD=change-me

# --- Database (Postgres; Supabase connection string works directly) ---
DATABASE_URL=postgres://user:password@host:5432/dbname

# --- AI generation ---
ANTHROPIC_API_KEY=

# --- Notifications ---
# "email" is the only implemented provider in v1. "dryrun" logs instead of sending (safe default for local dev).
NOTIFICATION_PROVIDER=dryrun
RESEND_API_KEY=
REMINDER_FROM_EMAIL=reminders@example.com
REMINDER_TO_EMAIL=you@example.com

# --- Cron auth ---
# Vercel Cron sends this as a bearer token; set the same value in Vercel's project env vars.
# Protects /api/cron/reminders from being triggered by anyone who finds the URL.
CRON_SECRET=change-me

# --- Safety gate ---
# Reminders are NEVER sent unless this is exactly "true". Keep "false" until you have
# tested the full approval -> reminder flow with NOTIFICATION_PROVIDER=dryrun first.
REMINDERS_LIVE=false

# --- Reel storage (Vercel Blob) ---
# Required for the Reels feature — rendered captioned videos are uploaded here
# to get a public URL. Create a Blob store for this project in the Vercel
# dashboard's Storage tab; it sets this automatically. Without it, reel
# processing will reach "ready_for_review" never — it fails at the upload step.
BLOB_READ_WRITE_TOKEN=
