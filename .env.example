# --- Access control (single shared login — this is a small internal tool, not a public app) ---
APP_USERNAME=admin
APP_PASSWORD=change-me

# --- Database (Postgres; Supabase connection string works directly) ---
DATABASE_URL=postgres://user:password@host:5432/dbname

# --- AI generation ---
ANTHROPIC_API_KEY=

# --- Notifications ---
# "email" is the only implemented provider in v1. "dryrun" logs instead of sending (safe default for local dev).
NOTIFICATION_PROVIDER=dryrun
RESEND_API_KEY=
REMINDER_FROM_EMAIL=reminders@example.com
REMINDER_TO_EMAIL=you@example.com

# --- Cron auth ---
# Vercel Cron sends this as a bearer token; set the same value in Vercel's project env vars.
# Protects /api/cron/reminders from being triggered by anyone who finds the URL.
CRON_SECRET=change-me

# --- Safety gate ---
# Reminders are NEVER sent unless this is exactly "true". Keep "false" until you have
# tested the full approval -> reminder flow with NOTIFICATION_PROVIDER=dryrun first.
REMINDERS_LIVE=false

# --- Reel storage (Supabase Storage — private buckets, signed URLs) ---
# SUPABASE_URL is https://<project-ref>.supabase.co.
# SUPABASE_SERVICE_ROLE_KEY: Supabase dashboard -> Project Settings -> API ->
# "service_role" secret. Server-only — never expose this to the browser.
# Used by the worker and server routes to read/write the reel-raw and
# reel-output buckets (created once via `npm run storage:setup`).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# NEXT_PUBLIC_* are intentionally public (same dashboard page, "anon" key) —
# the browser uses them only to complete a direct upload to a pre-signed
# URL the server already generated; see src/lib/storage/browserClient.ts.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Reel processing worker (Vercel Sandbox) ---
# Set after running the one-time snapshot build (see worker/README.md) —
# the ID of the Sandbox snapshot with whisper.cpp compiled and the Whisper
# model pre-downloaded. Without this, submitting a reel fails immediately
# with a clear error instead of hanging.
REEL_WORKER_SNAPSHOT_ID=

# Which Hebrew transcription model the worker uses. "small" (default) is
# standard multilingual Whisper. "ivrit-v2-d4" is ivrit.ai's Hebrew-tuned
# model (Apache-2.0, meaningfully more accurate) — if you set this, the
# Sandbox snapshot must include that model file too (see worker/README.md).
WHISPER_MODEL=small
